<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_streak"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Top Row: STREAK COUNT label & Flame Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="STREAK COUNT"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_flame_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_flame_circle"
                android:gravity="center"
                android:text="🔥"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Main Streak Value & Orange Underline Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0 Days"
                android:textColor="@color/widget_text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Colored Underline Bar -->
            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_underline_orange" />
        </LinearLayout>

        <!-- 7-Day Week Pips / Squares (Mon - Sun) -->
        <LinearLayout
            android:id="@+id/widget_streak_pips_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Day 0 (Mon) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_0"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="M"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 1 (Tue) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_1"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="T"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 2 (Wed) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_2"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="W"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 3 (Thu) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_3"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="T"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 4 (Fri) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_4"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="F"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 5 (Sat) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_5"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="S"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Day 6 (Sun) -->
            <FrameLayout
                android:id="@+id/widget_streak_pip_6"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pip_streak_off">
                <TextView
                    android:id="@+id/widget_streak_day_6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="S"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
